"""
MetroUI components for Django.
"""

from .css import merge_css_classes
from .html import render_tag


def render_alert(content, alert_type="info", dismissible=False, **attrs):
	"""
	Renders MetroUI alert component.

	Args:
		content: Alert content
		alert_type: Alert type (info, success, warning, danger, error)
		dismissible: Whether alert can be dismissed
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": f"alert alert-{alert_type}",
		"role": "alert"
	}

	if dismissible:
		default_attrs["class"] = merge_css_classes(default_attrs["class"], "alert-dismissible")

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	if dismissible:
		close_button = render_tag(
			"button",
			{
				"type": "button",
				"class": "button button-mini",
				"data-role": "close",
				"aria-label": "Close"
			},
			"&times;"
		)
		content = f"{content}{close_button}"

	return render_tag("div", attrs=final_attrs, content=content)


def render_button(content, button_type="default", size=None, outline=False, **attrs):
	"""
	Renders MetroUI button component.

	Args:
		content: Button text
		button_type: Button type (default, primary, secondary, success, danger, warning, info)
		size: Button size (sm, lg)
		outline: Outline style
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"type": "button",
		"class": "button"
	}

	if button_type != "default":
		if outline:
			default_attrs["class"] = merge_css_classes(default_attrs["class"], f"outline-{button_type}")
		else:
			default_attrs["class"] = merge_css_classes(default_attrs["class"], button_type)

	if size:
		default_attrs["class"] = merge_css_classes(default_attrs["class"], f"button-{size}")

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	return render_tag("button", attrs=final_attrs, content=content)


def render_tile(title, content=None, size="medium", color="blue", icon=None, **attrs):
	"""
	Renders MetroUI tile component.

	Args:
		title: Tile title
		content: Additional content
		size: Tile size (small, medium, large, wide, tall)
		color: Tile color
		icon: MetroUI icon
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": f"tile tile-{size} tile-{color}",
		"data-role": "tile"
	}

	if icon:
		default_attrs["data-icon"] = icon

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	tile_content = f"<h3 class='tile-title'>{title}</h3>"

	if content:
		tile_content += f"<small>{content}</small>"

	return render_tag("div", attrs=final_attrs, content=tile_content)


def render_card(header=None, content=None, footer=None, **attrs):
	"""
	Renders MetroUI card component.

	Args:
		header: Card header
		content: Card content
		footer: Card footer
		**attrs: Additional HTML attributes
	"""
	default_attrs = {"class": "card"}

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	card_parts = []

	if header:
		card_parts.append(render_tag("div", {"class": "card-header"}, header))

	if content:
		card_parts.append(render_tag("div", {"class": "card-content"}, content))

	if footer:
		card_parts.append(render_tag("div", {"class": "card-footer"}, footer))

	if not card_parts:
		card_parts.append(render_tag("div", {"class": "card-content"}, ""))

	return render_tag("div", attrs=final_attrs, content="".join(card_parts))


def render_progress(value, max_value=100, color="blue", size="default", **attrs):
	"""
	Renders MetroUI progress bar component.

	Args:
		value: Current value
		max_value: Maximum value
		color: Progress bar color
		size: Size (mini, small, large)
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": f"progress progress-{color}",
		"data-role": "progress",
		"data-value": str(value),
		"data-max": str(max_value)
	}

	if size != "default":
		default_attrs["class"] = merge_css_classes(default_attrs["class"], f"progress-{size}")

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	return render_tag("div", attrs=final_attrs, content="")


def render_accordion(items, **attrs):
	"""
	Renders MetroUI accordion component with advanced features.

	Args:
		items: List of dictionaries with 'title', 'content', and optional 'active' keys
		**attrs: Additional HTML attributes including:
			# Accordion Parameters
			- accordion_deferred: Deferred initialization time in milliseconds (number)
			- show_marker: Show/hide marker (arrow) in the heading (boolean)
			- material: Use material design style (boolean)
			- duration: Animation duration for expanding/collapsing (number)
			- one_frame: Allow only one frame to be open at a time (boolean)
			- show_active: Show active frames on initialization (boolean)
			- cls_frame: Additional CSS class for frames (string)
			- cls_heading: Additional CSS class for headings (string)
			- cls_content: Additional CSS class for content (string)
			- cls_accordion: Additional CSS class for the accordion container (string)
			- cls_active_frame: Additional CSS class for active frames (string)
			- cls_active_frame_heading: Additional CSS class for active frame headings (string)
			- cls_active_frame_content: Additional CSS class for active frame content (string)
	"""
	# Extract accordion-specific attributes
	accordion_attrs = {}
	standard_attrs = {}
	
	# Accordion-specific parameters
	accordion_params = [
		'accordion_deferred', 'show_marker', 'material', 'duration', 'one_frame',
		'show_active', 'cls_frame', 'cls_heading', 'cls_content', 'cls_accordion',
		'cls_active_frame', 'cls_active_frame_heading', 'cls_active_frame_content'
	]
	
	# Separate accordion attributes from standard HTML attributes
	for key, value in attrs.items():
		if key in accordion_params:
			accordion_attrs[key] = value
		else:
			standard_attrs[key] = value
	
	# Build base attributes
	default_attrs = {
		"data-role": "accordion"
	}
	
	# Add accordion-specific data attributes
	if accordion_attrs.get('accordion_deferred'):
		default_attrs["data-accordion-deferred"] = str(accordion_attrs['accordion_deferred'])
	
	if accordion_attrs.get('show_marker') is not None:
		default_attrs["data-show-marker"] = "true" if accordion_attrs['show_marker'] else "false"
	
	if accordion_attrs.get('material'):
		default_attrs["data-material"] = "true"
	
	if accordion_attrs.get('duration'):
		default_attrs["data-duration"] = str(accordion_attrs['duration'])
	
	if accordion_attrs.get('one_frame') is not None:
		default_attrs["data-one-frame"] = "true" if accordion_attrs['one_frame'] else "false"
	
	if accordion_attrs.get('show_active') is not None:
		default_attrs["data-show-active"] = "true" if accordion_attrs['show_active'] else "false"
	
	# Build CSS classes
	css_classes = ["accordion"]
	
	if accordion_attrs.get('material'):
		css_classes.append("material")
	
	if accordion_attrs.get('cls_accordion'):
		css_classes.append(accordion_attrs['cls_accordion'])
	
	default_attrs["class"] = " ".join(css_classes)
	
	# Merge with custom standard attributes
	final_attrs = {**default_attrs, **standard_attrs}
	
	# Generate accordion frames
	accordion_items = []
	for i, item in enumerate(items):
		# Determine if this frame should be active
		is_active = item.get('active', False)
		
		# Build frame classes
		frame_classes = ["frame"]
		if is_active:
			frame_classes.append("active")
		if accordion_attrs.get('cls_frame'):
			frame_classes.append(accordion_attrs['cls_frame'])
		if is_active and accordion_attrs.get('cls_active_frame'):
			frame_classes.append(accordion_attrs['cls_active_frame'])
		
		# Build heading classes
		heading_classes = ["heading"]
		if accordion_attrs.get('cls_heading'):
			heading_classes.append(accordion_attrs['cls_heading'])
		if is_active and accordion_attrs.get('cls_active_frame_heading'):
			heading_classes.append(accordion_attrs['cls_active_frame_heading'])
		
		# Build content classes
		content_classes = ["content"]
		if accordion_attrs.get('cls_content'):
			content_classes.append(accordion_attrs['cls_content'])
		if is_active and accordion_attrs.get('cls_active_frame_content'):
			content_classes.append(accordion_attrs['cls_active_frame_content'])
		
		# Create frame HTML
		frame_html = render_tag(
			"div",
			{"class": " ".join(frame_classes)},
			render_tag("div", {"class": " ".join(heading_classes)}, item.get('title', '')) +
			render_tag("div", {"class": " ".join(content_classes)}, item.get('content', ''))
		)
		accordion_items.append(frame_html)
	
	return render_tag("div", attrs=final_attrs, content="".join(accordion_items))


def render_action_button(actions, main_icon="mif-plus", **attrs):
	"""
	Renders MetroUI action button component with expandable sub-actions.

	Args:
		actions: List of dictionaries with 'icon', 'href', 'title', and optional 'onclick' keys
		main_icon: Icon class for the main action button (string)
		**attrs: Additional HTML attributes including:
			# Action Button Parameters
			- rotate: Add rotation effect to main button (boolean)
			- main_href: URL for main button (string)
			- main_title: Title/tooltip for main button (string)
			- main_onclick: JavaScript onclick handler for main button (string)
			- cls_action_button: Additional CSS class for action button container (string)
			- cls_main_action: Additional CSS class for main action button (string)
			- cls_actions: Additional CSS class for actions container (string)
			- cls_sub_action: Additional CSS class for sub-action items (string)
			- onClick: Callback function triggered when the main button is clicked (string)
			- onActionClick: Callback function triggered when a sub-action is clicked (string)
			- onActionButtonCreate: Callback function triggered when the action button is created (string)
	"""
	# Extract action button-specific attributes
	action_attrs = {}
	standard_attrs = {}
	
	# Action button-specific parameters
	action_params = [
		'rotate', 'main_href', 'main_title', 'main_onclick', 'cls_action_button',
		'cls_main_action', 'cls_actions', 'cls_sub_action', 'onClick', 'onActionClick',
		'onActionButtonCreate'
	]
	
	# Separate action button attributes from standard HTML attributes
	for key, value in attrs.items():
		if key in action_params:
			action_attrs[key] = value
		else:
			standard_attrs[key] = value
	
	# Build base attributes
	default_attrs = {
		"data-role": "action-button"
	}
	
	# Add action button-specific data attributes
	if action_attrs.get('onClick'):
		default_attrs["data-on-click"] = action_attrs['onClick']
	
	if action_attrs.get('onActionClick'):
		default_attrs["data-on-action-click"] = action_attrs['onActionClick']
	
	if action_attrs.get('onActionButtonCreate'):
		default_attrs["data-on-action-button-create"] = action_attrs['onActionButtonCreate']
	
	# Build CSS classes
	css_classes = ["action-button"]
	
	if action_attrs.get('cls_action_button'):
		css_classes.append(action_attrs['cls_action_button'])
	
	default_attrs["class"] = " ".join(css_classes)
	
	# Merge with custom standard attributes
	final_attrs = {**default_attrs, **standard_attrs}
	
	# Build main action button
	main_button_classes = ["main-action"]
	if action_attrs.get('rotate'):
		main_button_classes.append("rotate")
	if action_attrs.get('cls_main_action'):
		main_button_classes.append(action_attrs['cls_main_action'])
	
	main_button_attrs = {"class": " ".join(main_button_classes)}
	
	if action_attrs.get('main_href'):
		main_button_attrs["href"] = action_attrs['main_href']
	
	if action_attrs.get('main_title'):
		main_button_attrs["title"] = action_attrs['main_title']
	
	if action_attrs.get('main_onclick'):
		main_button_attrs["onclick"] = action_attrs['main_onclick']
	
	main_button = render_tag(
		"button",
		main_button_attrs,
		render_tag("span", {"class": "icon"}, render_tag("span", {"class": main_icon}))
	)
	
	# Build sub-actions
	actions_classes = ["actions"]
	if action_attrs.get('cls_actions'):
		actions_classes.append(action_attrs['cls_actions'])
	
	sub_actions = []
	for action in actions:
		sub_action_classes = ["sub-action"]
		if action_attrs.get('cls_sub_action'):
			sub_action_classes.append(action_attrs['cls_sub_action'])
		
		action_attrs_dict = {"class": " ".join(sub_action_classes)}
		
		if action.get('href'):
			action_attrs_dict["href"] = action['href']
		
		if action.get('title'):
			action_attrs_dict["title"] = action['title']
		
		if action.get('onclick'):
			action_attrs_dict["onclick"] = action['onclick']
		
		action_icon = action.get('icon', 'mif-circle')
		action_content = render_tag("span", {"class": action_icon})
		
		sub_action = render_tag("li", {}, render_tag("a", action_attrs_dict, action_content))
		sub_actions.append(sub_action)
	
	actions_list = render_tag("ul", {"class": " ".join(actions_classes)}, "".join(sub_actions))
	
	# Combine main button and actions
	content = main_button + actions_list
	
	return render_tag("div", attrs=final_attrs, content=content)


def render_activity(**attrs):
	"""
	Renders MetroUI activity component with animated loading indicators.

	Args:
		**attrs: Additional HTML attributes including:
			# Activity Parameters
			- activity_deferred: Deferred initialization time in milliseconds (number)
			- type: Type of activity indicator (string) - Options: "ring", "metro", "square", "cycle", "simple", "atom", "bars"
			- style: Style of the activity indicator (string) - Options: "", "dark", "color"
			- size: Size of the activity indicator in pixels (number)
			- radius: Radius for the "simple" type activity indicator (number)
			- on_activity_create: Callback function triggered when the activity indicator is created (string)
			- cls_activity: Additional CSS class for the activity container (string)
	"""
	# Extract activity-specific attributes
	activity_attrs = {}
	standard_attrs = {}
	
	# Activity-specific parameters
	activity_params = [
		'activity_deferred', 'type', 'style', 'size', 'radius', 
		'on_activity_create', 'cls_activity'
	]
	
	# Separate activity attributes from standard HTML attributes
	for key, value in attrs.items():
		if key in activity_params:
			activity_attrs[key] = value
		else:
			standard_attrs[key] = value
	
	# Build base attributes
	default_attrs = {
		"data-role": "activity"
	}
	
	# Add activity-specific data attributes
	if activity_attrs.get('activity_deferred'):
		default_attrs["data-activity-deferred"] = str(activity_attrs['activity_deferred'])
	
	if activity_attrs.get('type'):
		default_attrs["data-type"] = activity_attrs['type']
	
	if activity_attrs.get('style'):
		default_attrs["data-style"] = activity_attrs['style']
	
	if activity_attrs.get('size'):
		default_attrs["data-size"] = str(activity_attrs['size'])
	
	if activity_attrs.get('radius'):
		default_attrs["data-radius"] = str(activity_attrs['radius'])
	
	if activity_attrs.get('on_activity_create'):
		default_attrs["data-on-activity-create"] = activity_attrs['on_activity_create']
	
	# Build CSS classes
	css_classes = ["activity"]
	
	if activity_attrs.get('cls_activity'):
		css_classes.append(activity_attrs['cls_activity'])
	
	default_attrs["class"] = " ".join(css_classes)
	
	# Merge with custom standard attributes
	final_attrs = {**default_attrs, **standard_attrs}
	
	return render_tag("div", attrs=final_attrs, close=False)


def render_calendar(**attrs):
	"""
	Renders MetroUI calendar component.

	Args:
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "calendar",
		"data-role": "calendar"
	}

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	return render_tag("div", attrs=final_attrs, content="")


def render_dialog(title, content, **attrs):
	"""
	Renders MetroUI dialog component.

	Args:
		title: Dialog title
		content: Dialog content
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "dialog",
		"data-role": "dialog"
	}

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	dialog_content = render_tag("div", {"class": "dialog-title"}, title) + \
					 render_tag("div", {"class": "dialog-content"}, content)

	return render_tag("div", attrs=final_attrs, content=dialog_content)


def render_dropdown(items, button_text="Dropdown", **attrs):
	"""
	Renders MetroUI dropdown component.

	Args:
		items: List of dropdown items
		button_text: Button text
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "dropdown",
		"data-role": "dropdown"
	}

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	button = render_tag("button", {"class": "button dropdown-toggle"}, button_text)

	dropdown_items = []
	for item in items:
		if isinstance(item, dict):
			item_html = render_tag("a", {"href": item.get('url', '#')}, item.get('text', ''))
		else:
			item_html = render_tag("a", {"href": "#"}, str(item))
		dropdown_items.append(render_tag("li", {}, item_html))

	dropdown_menu = render_tag("ul", {"class": "dropdown-menu"}, "".join(dropdown_items))

	return render_tag("div", attrs=final_attrs, content=button + dropdown_menu)


def render_input(input_type="text", placeholder="", **attrs):
	"""
	Renders MetroUI input component with advanced features.

	Args:
		input_type: Input field type (text, password, email, search, etc.)
		placeholder: Placeholder text
		**attrs: Additional HTML attributes including:
			# Basic Parameters
			- label: Input label text
			- disabled: Disable the input (boolean)
			- readonly: Make input readonly (boolean)
			- required: Mark as required (boolean)
			- size: Custom width for the input
			- default_value: Default value for the input
			- prevent_submit: Prevent form submission on Enter key (boolean)
			- input_deferred: Delay in milliseconds before initializing (number)
			
			# Button Parameters
			- clear_button: Show clear button (boolean)
			- reveal_button: Show password reveal button (boolean)
			- search_button: Show search button (boolean)
			- random_button: Show random generator button (boolean)
			- clear_button_icon: Icon for clear button (string)
			- reveal_button_icon: Icon for reveal button (string)
			- search_button_icon: Icon for search button (string)
			- random_button_icon: Icon for random button (string)
			- search_button_click: Action for search button (string)
			- custom_buttons: Custom buttons configuration (array)
			
			# Autocomplete Parameters
			- autocomplete: Static autocomplete data (string/array)
			- autocomplete_url: URL to fetch autocomplete data (string)
			- autocomplete_url_method: HTTP method for autocomplete URL (string)
			- autocomplete_url_key: Key to extract data from JSON response (string)
			- autocomplete_divider: Divider for autocomplete string data (string)
			- autocomplete_list_height: Maximum height of autocomplete dropdown (number)
			
			# History Parameters
			- history: Enable input history functionality (boolean)
			- history_preset: Preset history items (string)
			- history_divider: Divider for history preset string (string)
			
			# Prepend/Append Parameters
			- prepend: Text to prepend to the input (string)
			- append: Text to append to the input (string)
			- prepend_options: Dropdown options to prepend (string)
			- append_options: Dropdown options to append (string)
			- prepend_options_sep: Separator for prepend options (string)
			- append_options_sep: Separator for append options (string)
			
			# Random Generation Parameters
			- random_symbols: Symbol groups for random generation (string)
			- random_length: Length of generated random string (number)
			
			# Mask Parameters
			- mask: The mask pattern defining the input format (string)
			- mask_pattern: Regular expression pattern for editable positions (string)
			- mask_placeholder: Character(s) used as placeholders in the mask (string)
			- mask_editable_start: Starting position from which user can edit (number)
			- threshold_interval: Time in milliseconds for cursor positioning threshold (number)
			- on_char: Callback function to transform characters (string)
			- on_input_mask_create: Callback function when input mask is created (string)
			
			# Styling Parameters
			- material: Use material design style (boolean)
			- pill: Use pill-shaped input (boolean)
			- rtl: Right-to-left text direction (boolean)
			- badge: Badge text to display (string)
			- cls_component: Additional CSS class for component container (string)
			- cls_input: Additional CSS class for input element (string)
			- cls_label: Additional CSS class for label (string)
			- cls_prepend: Additional CSS class for prepend element (string)
			- cls_append: Additional CSS class for append element (string)
			- cls_clear_button: Additional CSS class for clear button (string)
			- cls_reveal_button: Additional CSS class for reveal button (string)
			- cls_custom_button: Additional CSS class for custom buttons (string)
			- cls_search_button: Additional CSS class for search button (string)
			- cls_random_button: Additional CSS class for random button (string)
			
			# Validation Parameters
			- error: Show error state (boolean)
			- error_message: Error message text (string)
			- success: Show success state (boolean)
			- success_message: Success message text (string)
			- warning: Show warning state (boolean)
			- warning_message: Warning message text (string)
			- info: Show info state (boolean)
			- info_message: Info message text (string)
			- help_text: Help text to display (string)
			- max_length: Maximum input length (number)
			- min_length: Minimum input length (number)
			- pattern: HTML5 pattern validation (string)
			- step: Step value for number inputs (number)
			- min: Minimum value for number inputs (number)
			- max: Maximum value for number inputs (number)
			- multiple: Allow multiple values (boolean)
			- accept: File types to accept (string)
			- capture: Camera capture mode (string)
	"""
	import json
	
	def add_role(roles_string, new_role):
		"""Helper function to add a role to the roles string if not already present."""
		if new_role not in roles_string:
			return f"{roles_string}, {new_role}"
		return roles_string
	
	# Extract MetroUI-specific attributes
	metro_attrs = {}
	standard_attrs = {}
	
	# MetroUI-specific parameters
	metro_params = [
		# Basic parameters
		'label', 'disabled', 'readonly', 'required', 'size', 'default_value',
		'prevent_submit', 'input_deferred',
		
		# Button parameters
		'clear_button', 'reveal_button', 'search_button', 'random_button',
		'clear_button_icon', 'reveal_button_icon', 'search_button_icon', 'random_button_icon',
		'search_button_click', 'custom_buttons',
		
		# Autocomplete parameters
		'autocomplete', 'autocomplete_url', 'autocomplete_url_method', 'autocomplete_url_key',
		'autocomplete_divider', 'autocomplete_list_height',
		
		# History parameters
		'history', 'history_preset', 'history_divider',
		
		# Prepend/Append parameters
		'prepend', 'append', 'prepend_options', 'append_options',
		'prepend_options_sep', 'append_options_sep',
		
		# Random generation parameters
		'random_symbols', 'random_length',
		
		# Mask parameters
		'mask', 'mask_pattern', 'mask_placeholder', 'mask_editable_start',
		'threshold_interval', 'on_char', 'on_input_mask_create',
		
		# Styling parameters
		'material', 'pill', 'rtl', 'badge', 'cls_component', 'cls_input', 'cls_label',
		'cls_prepend', 'cls_append', 'cls_clear_button', 'cls_reveal_button',
		'cls_custom_button', 'cls_search_button', 'cls_random_button',
		
		# Validation parameters
		'error', 'error_message', 'success', 'success_message', 'warning', 'warning_message',
		'info', 'info_message', 'help_text', 'max_length', 'min_length', 'pattern',
		'step', 'min', 'max', 'multiple', 'accept', 'capture'
	]
	
	# Separate MetroUI attributes from standard HTML attributes
	for key, value in attrs.items():
		if key in metro_params:
			metro_attrs[key] = value
		else:
			standard_attrs[key] = value
	
	# Build base attributes
	default_attrs = {
		"type": input_type,
		"data-role": "input, input-common"  # input-common is always included for basic functionality
	}
	
	# Add placeholder if provided
	if placeholder:
		default_attrs["placeholder"] = placeholder
	
	# Add MetroUI-specific data attributes
	if metro_attrs.get('label'):
		default_attrs["data-label"] = metro_attrs['label']
	
	if metro_attrs.get('clear_button'):
		default_attrs["data-clear-button"] = "true"
	
	if metro_attrs.get('reveal_button'):
		default_attrs["data-reveal-button"] = "true"
	
	if metro_attrs.get('search_button'):
		default_attrs["data-search-button"] = "true"
	
	if metro_attrs.get('random_button'):
		default_attrs["data-random-button"] = "true"
	
	if metro_attrs.get('autocomplete'):
		default_attrs["data-autocomplete"] = metro_attrs['autocomplete']
	
	if metro_attrs.get('autocomplete_url'):
		default_attrs["data-autocomplete-url"] = metro_attrs['autocomplete_url']
		if metro_attrs.get('autocomplete_url_method'):
			default_attrs["data-autocomplete-url-method"] = metro_attrs['autocomplete_url_method']
	
	if metro_attrs.get('history'):
		default_attrs["data-history"] = "true"
		if metro_attrs.get('history_preset'):
			default_attrs["data-history-preset"] = metro_attrs['history_preset']
	
	if metro_attrs.get('prepend'):
		default_attrs["data-prepend"] = metro_attrs['prepend']
	
	if metro_attrs.get('append'):
		default_attrs["data-append"] = metro_attrs['append']
	
	if metro_attrs.get('prepend_options'):
		default_attrs["data-prepend-options"] = metro_attrs['prepend_options']
	
	if metro_attrs.get('append_options'):
		default_attrs["data-append-options"] = metro_attrs['append_options']
	
	if metro_attrs.get('custom_buttons'):
		if isinstance(metro_attrs['custom_buttons'], (list, dict)):
			default_attrs["data-custom-buttons"] = json.dumps(metro_attrs['custom_buttons'])
		else:
			default_attrs["data-custom-buttons"] = metro_attrs['custom_buttons']
	
	if metro_attrs.get('mask'):
		default_attrs["data-mask"] = metro_attrs['mask']
		default_attrs["data-role"] = add_role(default_attrs["data-role"], "input-mask")
	
	if metro_attrs.get('material'):
		default_attrs["data-material"] = "true"
		default_attrs["data-role"] = add_role(default_attrs["data-role"], "input-material")
	
	if metro_attrs.get('pill'):
		default_attrs["data-pill"] = "true"
	
	if metro_attrs.get('rtl'):
		default_attrs["data-rtl"] = "true"
	
	if metro_attrs.get('badge'):
		default_attrs["data-badge"] = metro_attrs['badge']
	
	if metro_attrs.get('autocomplete_list_height'):
		default_attrs["data-autocomplete-list-height"] = str(metro_attrs['autocomplete_list_height'])
	
	if metro_attrs.get('random_symbols'):
		default_attrs["data-random-symbols"] = metro_attrs['random_symbols']
	
	if metro_attrs.get('random_length'):
		default_attrs["data-random-length"] = str(metro_attrs['random_length'])
	
	# Add basic parameters
	if metro_attrs.get('input_deferred'):
		default_attrs["data-input-deferred"] = str(metro_attrs['input_deferred'])
	
	if metro_attrs.get('default_value'):
		default_attrs["data-default-value"] = metro_attrs['default_value']
	
	if metro_attrs.get('prevent_submit'):
		default_attrs["data-prevent-submit"] = "true"
	
	if metro_attrs.get('size') and metro_attrs['size'] != 'default':
		default_attrs["data-size"] = metro_attrs['size']
	
	# Add button icon parameters
	if metro_attrs.get('clear_button_icon'):
		default_attrs["data-clear-button-icon"] = metro_attrs['clear_button_icon']
	
	if metro_attrs.get('reveal_button_icon'):
		default_attrs["data-reveal-button-icon"] = metro_attrs['reveal_button_icon']
	
	if metro_attrs.get('search_button_icon'):
		default_attrs["data-search-button-icon"] = metro_attrs['search_button_icon']
	
	if metro_attrs.get('random_button_icon'):
		default_attrs["data-random-button-icon"] = metro_attrs['random_button_icon']
	
	if metro_attrs.get('search_button_click'):
		default_attrs["data-search-button-click"] = metro_attrs['search_button_click']
	
	# Add autocomplete advanced parameters
	if metro_attrs.get('autocomplete_url_key'):
		default_attrs["data-autocomplete-url-key"] = metro_attrs['autocomplete_url_key']
	
	if metro_attrs.get('autocomplete_divider'):
		default_attrs["data-autocomplete-divider"] = metro_attrs['autocomplete_divider']
	
	# Add history advanced parameters
	if metro_attrs.get('history_divider'):
		default_attrs["data-history-divider"] = metro_attrs['history_divider']
	
	# Add prepend/append advanced parameters
	if metro_attrs.get('prepend_options_sep'):
		default_attrs["data-prepend-options-sep"] = metro_attrs['prepend_options_sep']
	
	if metro_attrs.get('append_options_sep'):
		default_attrs["data-append-options-sep"] = metro_attrs['append_options_sep']
	
	# Add mask advanced parameters
	if metro_attrs.get('mask_pattern'):
		default_attrs["data-mask-pattern"] = metro_attrs['mask_pattern']
	
	if metro_attrs.get('mask_placeholder'):
		default_attrs["data-mask-placeholder"] = metro_attrs['mask_placeholder']
	
	if metro_attrs.get('mask_editable_start'):
		default_attrs["data-mask-editable-start"] = str(metro_attrs['mask_editable_start'])
	
	if metro_attrs.get('threshold_interval'):
		default_attrs["data-threshold-interval"] = str(metro_attrs['threshold_interval'])
	
	# Add callback functions (as JavaScript function names)
	if metro_attrs.get('on_char'):
		default_attrs["data-on-char"] = metro_attrs['on_char']
	
	if metro_attrs.get('on_input_mask_create'):
		default_attrs["data-on-input-mask-create"] = metro_attrs['on_input_mask_create']
	
	# Add validation and state attributes
	if metro_attrs.get('error') or metro_attrs.get('error_message'):
		default_attrs["data-error"] = "true"
		if metro_attrs.get('error_message'):
			default_attrs["data-error-message"] = metro_attrs['error_message']
	
	if metro_attrs.get('success') or metro_attrs.get('success_message'):
		default_attrs["data-success"] = "true"
		if metro_attrs.get('success_message'):
			default_attrs["data-success-message"] = metro_attrs['success_message']
	
	if metro_attrs.get('warning') or metro_attrs.get('warning_message'):
		default_attrs["data-warning"] = "true"
		if metro_attrs.get('warning_message'):
			default_attrs["data-warning-message"] = metro_attrs['warning_message']
	
	if metro_attrs.get('info') or metro_attrs.get('info_message'):
		default_attrs["data-info"] = "true"
		if metro_attrs.get('info_message'):
			default_attrs["data-info-message"] = metro_attrs['info_message']
	
	if metro_attrs.get('help_text'):
		default_attrs["data-help"] = metro_attrs['help_text']
	
	# Add HTML5 validation attributes
	if metro_attrs.get('max_length'):
		default_attrs["maxlength"] = str(metro_attrs['max_length'])
	
	if metro_attrs.get('min_length'):
		default_attrs["minlength"] = str(metro_attrs['min_length'])
	
	if metro_attrs.get('pattern'):
		default_attrs["pattern"] = metro_attrs['pattern']
	
	if metro_attrs.get('step'):
		default_attrs["step"] = str(metro_attrs['step'])
	
	if metro_attrs.get('min'):
		default_attrs["min"] = str(metro_attrs['min'])
	
	if metro_attrs.get('max'):
		default_attrs["max"] = str(metro_attrs['max'])
	
	if metro_attrs.get('size'):
		default_attrs["size"] = str(metro_attrs['size'])
	
	if metro_attrs.get('multiple'):
		default_attrs["multiple"] = "multiple"
	
	if metro_attrs.get('accept'):
		default_attrs["accept"] = metro_attrs['accept']
	
	if metro_attrs.get('capture'):
		default_attrs["capture"] = metro_attrs['capture']
	
	# Build CSS classes
	css_classes = ["input"]
	
	if metro_attrs.get('material'):
		css_classes.append("material-input")
	
	if metro_attrs.get('pill'):
		css_classes.append("pill-input")
	
	if metro_attrs.get('rtl'):
		css_classes.append("rtl")
	
	# Add validation state classes
	if metro_attrs.get('error') or metro_attrs.get('error_message'):
		css_classes.append("error")
	
	if metro_attrs.get('success') or metro_attrs.get('success_message'):
		css_classes.append("success")
	
	if metro_attrs.get('warning') or metro_attrs.get('warning_message'):
		css_classes.append("warning")
	
	if metro_attrs.get('info') or metro_attrs.get('info_message'):
		css_classes.append("info")
	
	if metro_attrs.get('cls_component'):
		css_classes.append(metro_attrs['cls_component'])
	
	if metro_attrs.get('cls_input'):
		css_classes.append(metro_attrs['cls_input'])
	
	# Add additional CSS classes for specific elements
	additional_classes = []
	if metro_attrs.get('cls_prepend'):
		additional_classes.append(f"prepend-{metro_attrs['cls_prepend']}")
	if metro_attrs.get('cls_append'):
		additional_classes.append(f"append-{metro_attrs['cls_append']}")
	if metro_attrs.get('cls_clear_button'):
		additional_classes.append(f"clear-{metro_attrs['cls_clear_button']}")
	if metro_attrs.get('cls_reveal_button'):
		additional_classes.append(f"reveal-{metro_attrs['cls_reveal_button']}")
	if metro_attrs.get('cls_custom_button'):
		additional_classes.append(f"custom-{metro_attrs['cls_custom_button']}")
	if metro_attrs.get('cls_search_button'):
		additional_classes.append(f"search-{metro_attrs['cls_search_button']}")
	if metro_attrs.get('cls_random_button'):
		additional_classes.append(f"random-{metro_attrs['cls_random_button']}")
	
	if additional_classes:
		css_classes.extend(additional_classes)
	
	default_attrs["class"] = " ".join(css_classes)
	
	# Add standard HTML attributes
	if metro_attrs.get('disabled'):
		default_attrs["disabled"] = "disabled"
	
	if metro_attrs.get('readonly'):
		default_attrs["readonly"] = "readonly"
	
	if metro_attrs.get('required'):
		default_attrs["required"] = "required"
	
	# Merge with custom standard attributes
	final_attrs = {**default_attrs, **standard_attrs}
	
	return render_tag("input", attrs=final_attrs, close=False)


def render_material_input(input_type="text", placeholder="", **attrs):
	"""
	Renders MetroUI material input component with material design features.

	Args:
		input_type: Input field type (text, password, email, search, etc.)
		placeholder: Placeholder text
		**attrs: Additional HTML attributes including:
			# Material Design Parameters
			- label: Text for the floating label (string)
			- informer: Helper text displayed below the input (string)
			- icon: Icon displayed to the left of the input (string)
			- permanent_label: When true, the label is always visible (boolean)
			- search_button: When true, displays a search button (boolean)
			- clear_button: When true, displays a clear button (boolean)
			- reveal_button: When true, displays a reveal button for password inputs (boolean)
			- clear_button_icon: Icon for the clear button (string)
			- reveal_button_icon: Icon for the reveal button (string)
			- search_button_icon: Icon for the search button (string)
			- search_button_click: Action for search button click (string)
			- custom_buttons: Array of custom button objects (array)
			- cls_component: Additional CSS class for the component container (string)
			- cls_input: Additional CSS class for the input element (string)
			- cls_label: Additional CSS class for the label (string)
			- cls_informer: Additional CSS class for the informer (string)
			- cls_icon: Additional CSS class for the icon (string)
			- cls_line: Additional CSS class for the underline (string)
			
			# Standard HTML attributes
			- disabled: Disable the input (boolean)
			- readonly: Make input readonly (boolean)
			- required: Mark as required (boolean)
			- max_length: Maximum input length (number)
			- min_length: Minimum input length (number)
			- pattern: HTML5 pattern validation (string)
			- step: Step value for number inputs (number)
			- min: Minimum value for number inputs (number)
			- max: Maximum value for number inputs (number)
			- multiple: Allow multiple values (boolean)
			- accept: File types to accept (string)
			- capture: Camera capture mode (string)
	"""
	import json
	
	# Extract MetroUI Material-specific attributes
	material_attrs = {}
	standard_attrs = {}
	
	# MetroUI Material-specific parameters
	material_params = [
		'label', 'informer', 'icon', 'permanent_label', 'search_button', 'clear_button',
		'reveal_button', 'clear_button_icon', 'reveal_button_icon', 'search_button_icon',
		'search_button_click', 'custom_buttons', 'cls_component', 'cls_input', 'cls_label',
		'cls_informer', 'cls_icon', 'cls_line', 'disabled', 'readonly', 'required',
		'max_length', 'min_length', 'pattern', 'step', 'min', 'max', 'multiple',
		'accept', 'capture'
	]
	
	# Separate Material attributes from standard HTML attributes
	for key, value in attrs.items():
		if key in material_params:
			material_attrs[key] = value
		else:
			standard_attrs[key] = value
	
	# Build base attributes
	default_attrs = {
		"type": input_type,
		"data-role": "material-input"
	}
	
	# Add placeholder if provided
	if placeholder:
		default_attrs["placeholder"] = placeholder
	
	# Add Material-specific data attributes
	if material_attrs.get('label'):
		default_attrs["data-label"] = material_attrs['label']
	
	if material_attrs.get('informer'):
		default_attrs["data-informer"] = material_attrs['informer']
	
	if material_attrs.get('icon'):
		default_attrs["data-icon"] = material_attrs['icon']
	
	if material_attrs.get('permanent_label'):
		default_attrs["data-permanent-label"] = "true"
	
	if material_attrs.get('search_button'):
		default_attrs["data-search-button"] = "true"
	
	if material_attrs.get('clear_button'):
		default_attrs["data-clear-button"] = "true"
	
	if material_attrs.get('reveal_button'):
		default_attrs["data-reveal-button"] = "true"
	
	if material_attrs.get('clear_button_icon'):
		default_attrs["data-clear-button-icon"] = material_attrs['clear_button_icon']
	
	if material_attrs.get('reveal_button_icon'):
		default_attrs["data-reveal-button-icon"] = material_attrs['reveal_button_icon']
	
	if material_attrs.get('search_button_icon'):
		default_attrs["data-search-button-icon"] = material_attrs['search_button_icon']
	
	if material_attrs.get('search_button_click'):
		default_attrs["data-search-button-click"] = material_attrs['search_button_click']
	
	if material_attrs.get('custom_buttons'):
		if isinstance(material_attrs['custom_buttons'], (list, dict)):
			default_attrs["data-custom-buttons"] = json.dumps(material_attrs['custom_buttons'])
		else:
			default_attrs["data-custom-buttons"] = material_attrs['custom_buttons']
	
	# Add HTML5 validation attributes
	if material_attrs.get('max_length'):
		default_attrs["maxlength"] = str(material_attrs['max_length'])
	
	if material_attrs.get('min_length'):
		default_attrs["minlength"] = str(material_attrs['min_length'])
	
	if material_attrs.get('pattern'):
		default_attrs["pattern"] = material_attrs['pattern']
	
	if material_attrs.get('step'):
		default_attrs["step"] = str(material_attrs['step'])
	
	if material_attrs.get('min'):
		default_attrs["min"] = str(material_attrs['min'])
	
	if material_attrs.get('max'):
		default_attrs["max"] = str(material_attrs['max'])
	
	if material_attrs.get('multiple'):
		default_attrs["multiple"] = "multiple"
	
	if material_attrs.get('accept'):
		default_attrs["accept"] = material_attrs['accept']
	
	if material_attrs.get('capture'):
		default_attrs["capture"] = material_attrs['capture']
	
	# Build CSS classes
	css_classes = ["input-material"]
	
	# Add icon class if icon is present
	if material_attrs.get('icon'):
		css_classes.append("with-icon")
	
	# Add permanent label class if permanent label is enabled
	if material_attrs.get('permanent_label'):
		css_classes.append("permanent-label")
	
	# Add custom CSS classes
	if material_attrs.get('cls_component'):
		css_classes.append(material_attrs['cls_component'])
	
	if material_attrs.get('cls_input'):
		css_classes.append(material_attrs['cls_input'])
	
	# Add additional CSS classes for specific elements
	additional_classes = []
	if material_attrs.get('cls_label'):
		additional_classes.append(f"label-{material_attrs['cls_label']}")
	if material_attrs.get('cls_informer'):
		additional_classes.append(f"informer-{material_attrs['cls_informer']}")
	if material_attrs.get('cls_icon'):
		additional_classes.append(f"icon-{material_attrs['cls_icon']}")
	if material_attrs.get('cls_line'):
		additional_classes.append(f"line-{material_attrs['cls_line']}")
	
	if additional_classes:
		css_classes.extend(additional_classes)
	
	default_attrs["class"] = " ".join(css_classes)
	
	# Add standard HTML attributes
	if material_attrs.get('disabled'):
		default_attrs["disabled"] = "disabled"
	
	if material_attrs.get('readonly'):
		default_attrs["readonly"] = "readonly"
	
	if material_attrs.get('required'):
		default_attrs["required"] = "required"
	
	# Merge with custom standard attributes
	final_attrs = {**default_attrs, **standard_attrs}
	
	return render_tag("input", attrs=final_attrs, close=False)


def render_list(items, list_type="ul", **attrs):
	"""
	Renders MetroUI list component.

	Args:
		items: List of items
		list_type: List type (ul, ol)
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "list",
		"data-role": "list"
	}

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	list_items = []
	for item in items:
		if isinstance(item, dict):
			item_html = render_tag("a", {"href": item.get('url', '#')}, item.get('text', ''))
		else:
			item_html = str(item)
		list_items.append(render_tag("li", {}, item_html))

	return render_tag(list_type, attrs=final_attrs, content="".join(list_items))


def render_menu(items, **attrs):
	"""
	Renders MetroUI menu component.

	Args:
		items: List of menu items
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "menu",
		"data-role": "menu"
	}

	# Merge with custom attributes
	final_attrs = {**default_attrs, **attrs}

	menu_items = []
	for item in items:
		if isinstance(item, dict):
			item_html = render_tag("a", {"href": item.get('url', '#')}, item.get('text', ''))
		else:
			item_html = render_tag("a", {"href": "#"}, str(item))
		menu_items.append(render_tag("li", {}, item_html))

	return render_tag("ul", attrs=final_attrs, content="".join(menu_items))


def render_navigation(items, **attrs):
	"""
	Renders MetroUI navigation component.

	Args:
		items: List of navigation items
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "navigation",
		"data-role": "navigation"
	}

	final_attrs = {**default_attrs, **attrs}

	nav_items = []
	for item in items:
		if isinstance(item, dict):
			item_html = render_tag("a", {"href": item.get('url', '#')}, item.get('text', ''))
		else:
			item_html = render_tag("a", {"href": "#"}, str(item))
		nav_items.append(render_tag("li", {}, item_html))

	return render_tag("nav", attrs=final_attrs, content=render_tag("ul", {}, "".join(nav_items)))


def render_panel(title=None, content=None, **attrs):
	"""
	Renders MetroUI panel component.

	Args:
		title: Panel title
		content: Panel content
		**attrs: Дополнительные HTML атрибуты
	"""
	default_attrs = {"class": "panel"}

	final_attrs = {**default_attrs, **attrs}

	panel_parts = []

	if title:
		panel_parts.append(render_tag("div", {"class": "panel-header"}, title))

	if content:
		panel_parts.append(render_tag("div", {"class": "panel-content"}, content))

	if not panel_parts:
		panel_parts.append(render_tag("div", {"class": "panel-content"}, ""))

	return render_tag("div", attrs=final_attrs, content="".join(panel_parts))


def render_sidebar(items, **attrs):
	"""
	Renders MetroUI sidebar component.

	Args:
		items: List of sidebar items
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "sidebar",
		"data-role": "sidebar"
	}

	final_attrs = {**default_attrs, **attrs}

	sidebar_items = []
	for item in items:
		if isinstance(item, dict):
			item_html = render_tag("a", {"href": item.get('url', '#')}, item.get('text', ''))
		else:
			item_html = render_tag("a", {"href": "#"}, str(item))
		sidebar_items.append(render_tag("li", {}, item_html))

	return render_tag("div", attrs=final_attrs, content=render_tag("ul", {}, "".join(sidebar_items)))


def render_table(headers, rows, **attrs):
	"""
	Renders MetroUI table component.

	Args:
		headers: List of table headers
		rows: List of rows (each row is a list of cells)
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "table",
		"data-role": "table"
	}

	final_attrs = {**default_attrs, **attrs}

	# Headers
	header_cells = [render_tag("th", {}, str(header)) for header in headers]
	header_row = render_tag("tr", {}, "".join(header_cells))

	# Rows
	table_rows = []
	for row in rows:
		cells = [render_tag("td", {}, str(cell)) for cell in row]
		table_rows.append(render_tag("tr", {}, "".join(cells)))

	table_body = "".join(table_rows)

	return render_tag("table", attrs=final_attrs, content=header_row + table_body)


def render_tabs(tabs, **attrs):
	"""
	Renders MetroUI tabs component.

	Args:
		tabs: List of dictionaries with 'title' and 'content' keys
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "tabs",
		"data-role": "tabs"
	}

	final_attrs = {**default_attrs, **attrs}

	# Tab navigation
	tab_nav = []
	tab_content = []

	for i, tab in enumerate(tabs):
		is_active = "active" if i == 0 else ""
		tab_nav.append(render_tag("a", {"class": f"tab {is_active}", "href": f"#tab-{i}"}, tab.get('title', '')))
		tab_content.append(
			render_tag("div", {"class": f"tab-content {is_active}", "id": f"tab-{i}"}, tab.get('content', '')))

	nav = render_tag("div", {"class": "tab-nav"}, "".join(tab_nav))
	content = render_tag("div", {"class": "tab-content-wrapper"}, "".join(tab_content))

	return render_tag("div", attrs=final_attrs, content=nav + content)


def render_toolbar(items, **attrs):
	"""
	Renders MetroUI toolbar component.

	Args:
		items: List of toolbar items
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "toolbar",
		"data-role": "toolbar"
	}

	final_attrs = {**default_attrs, **attrs}

	toolbar_items = []
	for item in items:
		if isinstance(item, dict):
			if item.get('type') == 'button':
				item_html = render_button(item.get('text', ''), **item.get('button_attrs', {}))
			else:
				item_html = render_tag("a", {"href": item.get('url', '#')}, item.get('text', ''))
		else:
			item_html = str(item)
		toolbar_items.append(render_tag("div", {"class": "toolbar-item"}, item_html))

	return render_tag("div", attrs=final_attrs, content="".join(toolbar_items))


def render_modal(title, content, **attrs):
	"""
	Renders MetroUI modal component.

	Args:
		title: Modal title
		content: Modal content
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "modal",
		"data-role": "modal"
	}

	final_attrs = {**default_attrs, **attrs}

	modal_header = render_tag("div", {"class": "modal-header"}, title)
	modal_body = render_tag("div", {"class": "modal-body"}, content)
	modal_footer = render_tag("div", {"class": "modal-footer"},
							  render_button("Close", button_type="secondary", **{"data-role": "close"}))

	modal_content = modal_header + modal_body + modal_footer

	return render_tag("div", attrs=final_attrs, content=modal_content)


def render_breadcrumb(items, **attrs):
	"""
	Renders MetroUI breadcrumb component.

	Args:
		items: List of breadcrumb items
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "breadcrumb",
		"data-role": "breadcrumb"
	}

	final_attrs = {**default_attrs, **attrs}

	breadcrumb_items = []
	for i, item in enumerate(items):
		if isinstance(item, dict):
			item_html = render_tag("a", {"href": item.get('url', '#')}, item.get('text', ''))
		else:
			item_html = str(item)

		if i < len(items) - 1:
			item_html += render_tag("span", {"class": "separator"}, "/")

		breadcrumb_items.append(render_tag("li", {}, item_html))

	return render_tag("nav", attrs=final_attrs, content=render_tag("ul", {}, "".join(breadcrumb_items)))


def render_pagination(current_page, total_pages, **attrs):
	"""
	Renders MetroUI pagination component.

	Args:
		current_page: Current page
		total_pages: Total number of pages
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "pagination",
		"data-role": "pagination"
	}

	final_attrs = {**default_attrs, **attrs}

	pagination_items = []

	# Previous button
	if current_page > 1:
		prev_item = render_tag("a", {"href": f"?page={current_page - 1}"}, "&laquo;")
		pagination_items.append(render_tag("li", {}, prev_item))

	# Page numbers
	for page in range(1, total_pages + 1):
		if page == current_page:
			page_item = render_tag("span", {"class": "current"}, str(page))
		else:
			page_item = render_tag("a", {"href": f"?page={page}"}, str(page))
		pagination_items.append(render_tag("li", {}, page_item))

	# Next button
	if current_page < total_pages:
		next_item = render_tag("a", {"href": f"?page={current_page + 1}"}, "&raquo;")
		pagination_items.append(render_tag("li", {}, next_item))

	return render_tag("nav", attrs=final_attrs, content=render_tag("ul", {}, "".join(pagination_items)))


def render_badge(content, badge_type="default", **attrs):
	"""
	Renders MetroUI badge component.

	Args:
		content: Badge content
		badge_type: Badge type (default, primary, secondary, success, danger, warning, info)
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": f"badge badge-{badge_type}"
	}

	final_attrs = {**default_attrs, **attrs}

	return render_tag("span", attrs=final_attrs, content=content)


def render_avatar(image_url, **attrs):
	"""
	Renders MetroUI avatar component.

	Args:
		image_url: Image URL
		**attrs: Additional HTML attributes
	"""
	avatar_attrs = {
		"classes": ["avatar"],
		"data-attr": {},
		"html-attr": {}
	}

	tag = None

	def filter_avatar_attrs(attrs, avatar_attrs):
		attrs_to_remove = []

		# Process avatar_class attributes
		for key, value in attrs.items():
			if key == "avatar_class":
				classes = value.split(",")
				for cls in classes:
					cls = cls.strip()
					if cls:
						avatar_attrs['classes'].append(cls)
				attrs_to_remove.append(key)

		# Process avatar_data_attr_* attributes
		for key, value in attrs.items():
			if key.startswith("avatar_data_attr_"):
				data_key = key[len("avatar_data_attr_"):]
				avatar_attrs['data-attr'][data_key] = value
				attrs_to_remove.append(key)

		# Process avatar_html_attr_* attributes
		for key, value in attrs.items():
			if key.startswith("avatar_html_attr_"):
				html_key = key[len("avatar_html_attr_"):]
				avatar_attrs['html-attr'][html_key] = value
				attrs_to_remove.append(key)

		# Remove processed attributes
		for key in attrs_to_remove:
			attrs.pop(key, None)

		return attrs, avatar_attrs

	# Filter attributes
	attrs, avatar_attrs = filter_avatar_attrs(attrs, avatar_attrs)

	if image_url == '':
		image_url = None

	if image_url is None and attrs.get("icon_name"):
		icon = attrs.get("icon_name", "person")
		try:
			attrs.pop("icon_name")
		except:
			pass
		tag = render_icon_avatar(icon, **attrs)
	elif image_url is None and attrs.get("initials"):
		tag = render_initials_avatar(attrs.get("initials"), **attrs)
	else:
		tag = render_image_avatar(image_url, **attrs)

	# Build data attributes string
	data_attrs_str = ""
	for key, value in avatar_attrs['data-attr'].items():
		data_attrs_str += f' data-{key}="{value}"'

	# Build HTML attributes string
	html_attrs_str = ""
	for key, value in avatar_attrs['html-attr'].items():
		html_attrs_str += f' {key}="{value}"'

	return f"""
		<div class="{' '.join(avatar_attrs['classes'])}"{data_attrs_str}{html_attrs_str}>
			{tag}
		</div>
	"""


def render_initials_avatar(name, **attr):
	"""
	Renders MetroUI initials avatar component.

	Args:
		name: Full name to generate initials from
		**attr: Additional attributes including:
			- size: Avatar size (small, medium, large, xlarge)
			- bg_color: Background color (default: auto-generated from name)
			- text_color: Text color (default: white)
			- font_size: Font size in pixels (default: auto-calculated)
			- font_weight: Font weight (default: bold)
			- shape: Avatar shape (circle, square, rounded)
			- max_initials: Maximum number of initials to show (default: 2)
			- output_format: Image format (png, jpg, webp) - default: png
			- save_path: Custom save path for generated image
	"""
	import hashlib
	import re
	import os
	from django.conf import settings
	from PIL import Image, ImageDraw, ImageFont
	import io
	import base64

	# Default settings
	settings_config = {
		"size": attr.get("size", "medium"),
		"bg_color": attr.get("bg_color"),
		"text_color": attr.get("text_color", "white"),
		"font_size": attr.get("font_size"),
		"font_weight": attr.get("font_weight", "bold"),
		"shape": attr.get("shape", "circle"),
		"max_initials": attr.get("max_initials", 2),
		"output_format": attr.get("output_format", "png"),
		"save_path": attr.get("save_path")
	}

	# Generate initials from name
	def generate_initials(full_name, max_count=2):
		"""Extract initials from full name"""
		if not full_name:
			return "?"

		# Split name and clean up
		name_parts = re.split(r'[\s\-_]+', full_name.strip())
		name_parts = [part for part in name_parts if part]

		if not name_parts:
			return "?"

		# Extract initials
		initials = []
		for part in name_parts:
			if part and len(initials) < max_count:
				initials.append(part[0].upper())

		return ''.join(initials)

	# Generate background color from name
	def generate_bg_color(full_name):
		"""Generate consistent background color from name"""
		if not full_name:
			return "#6c757d"

		# Create hash from name
		name_hash = hashlib.md5(full_name.lower().encode()).hexdigest()

		# Predefined color palette for avatars
		colors = [
			"#e74c3c", "#3498db", "#2ecc71", "#f39c12", "#9b59b6",
			"#1abc9c", "#e67e22", "#34495e", "#16a085", "#27ae60",
			"#2980b9", "#8e44ad", "#f1c40f", "#e74c3c", "#95a5a6",
			"#d35400", "#c0392b", "#7f8c8d", "#2c3e50", "#f8f9fa"
		]

		# Use hash to select color
		color_index = int(name_hash[:8], 16) % len(colors)
		return colors[color_index]

	# Convert color to RGB
	def color_to_rgb(color):
		"""Convert hex color or color name to RGB tuple"""
		# Handle hex colors
		if color.startswith('#'):
			hex_color = color.lstrip('#')
			return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))

		# Handle common color names
		color_map = {
			'white': (255, 255, 255),
			'black': (0, 0, 0),
			'red': (255, 0, 0),
			'green': (0, 255, 0),
			'blue': (0, 0, 255),
			'yellow': (255, 255, 0),
			'cyan': (0, 255, 255),
			'magenta': (255, 0, 255),
			'gray': (128, 128, 128),
			'grey': (128, 128, 128),
			'orange': (255, 165, 0),
			'purple': (128, 0, 128),
			'brown': (165, 42, 42),
			'pink': (255, 192, 203),
			'lime': (0, 255, 0),
			'navy': (0, 0, 128),
			'teal': (0, 128, 128),
			'olive': (128, 128, 0),
			'maroon': (128, 0, 0),
			'silver': (192, 192, 192),
			'gold': (255, 215, 0)
		}

		return color_map.get(color.lower(), (255, 255, 255))  # Default to white

	# Get size dimensions
	def get_size_dimensions(size):
		"""Get width and height for given size"""
		size_map = {
			"small": 32,
			"medium": 48,
			"large": 64,
			"xlarge": 96
		}
		return size_map.get(size, 48)

	# Get font size based on avatar size
	def get_font_size(avatar_size, text_length):
		"""Calculate appropriate font size"""
		if settings_config["font_size"]:
			return settings_config["font_size"]

		# Base font size calculation
		base_size = avatar_size * 0.4

		# Adjust for text length
		if text_length > 2:
			base_size *= 0.8
		elif text_length == 1:
			base_size *= 1.2

		return int(base_size)

	# Generate the image
	def generate_avatar_image(initials, dimensions, bg_color, text_color, font_size, shape):
		"""Generate avatar image using PIL"""
		# Create image with RGBA support for transparency
		img = Image.new('RGBA', (dimensions, dimensions), (0, 0, 0, 0))
		draw = ImageDraw.Draw(img)

		# Convert colors
		bg_rgb = color_to_rgb(bg_color)
		text_rgb = color_to_rgb(text_color)

		# Create background
		if shape == "circle":
			# Draw circle background
			draw.ellipse([0, 0, dimensions-1, dimensions-1], fill=bg_rgb)
		elif shape == "rounded":
			# Draw rounded rectangle
			radius = dimensions // 8
			draw.rounded_rectangle([0, 0, dimensions-1, dimensions-1], radius=radius, fill=bg_rgb)
		else:  # square
			draw.rectangle([0, 0, dimensions-1, dimensions-1], fill=bg_rgb)

		# Try to load Geologica font first, then fallback to system fonts
		font = None

		# Try to load Geologica from various possible locations
		geologica_paths = [
			# Common system font directories
			"/System/Library/Fonts/Geologica.ttf",  # macOS
			"/usr/share/fonts/truetype/google/Geologica.ttf",  # Linux
			"/usr/local/share/fonts/Geologica.ttf",  # Linux
			"~/.fonts/Geologica.ttf",  # User fonts
			# Project-specific font directory
			os.path.join(os.path.dirname(__file__), "static", "fonts", "Geologica.ttf"),
			# Example project fonts
			os.path.join(os.path.dirname(__file__), "..", "example", "static", "fonts", "Geologica.ttf"),
		]

		for font_path in geologica_paths:
			try:
				expanded_path = os.path.expanduser(font_path)
				if os.path.exists(expanded_path):
					# Load Geologica variable font - it will use the default weight
					font = ImageFont.truetype(expanded_path, font_size)
					break
			except:
				continue

		# If Geologica not found, try system fonts as fallback
		if font is None:
			try:
				# Try to use a system font - prefer bold fonts for better centering
				font = ImageFont.truetype("/System/Library/Fonts/Arial Bold.ttf", font_size)
			except:
				try:
					# Try alternative bold system fonts
					font = ImageFont.truetype("/System/Library/Fonts/Helvetica.ttc", font_size)
				except:
					try:
						# Try Linux fonts
						font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", font_size)
					except:
						try:
							# Try macOS fonts
							font = ImageFont.truetype("/System/Library/Fonts/Arial.ttf", font_size)
						except:
							# Fallback to default font
							font = ImageFont.load_default()

		# Calculate text position (center)
		bbox = draw.textbbox((0, 0), initials, font=font)
		text_width = bbox[2] - bbox[0]
		text_height = bbox[3] - bbox[1]

		# Center the text both horizontally and vertically
		x = (dimensions - text_width) // 2
		y = (dimensions - text_height) // 2

		# Adjust for font baseline - PIL draws text from the top-left of the text baseline
		# We need to account for the font's ascent and descent
		font_ascent = font.getmetrics()[0]  # Get font ascent
		y = (dimensions - text_height) // 2 - font_ascent // 4

		# Ensure text stays within bounds
		x = max(0, min(x, dimensions - text_width))
		y = max(0, min(y, dimensions - text_height))

		# Draw text
		draw.text((x, y), initials, fill=text_rgb, font=font)

		return img

	# Generate initials
	initials = generate_initials(name, settings_config["max_initials"])

	# Get dimensions
	dimensions = get_size_dimensions(settings_config["size"])

	# Generate background color if not provided
	bg_color = settings_config["bg_color"] or generate_bg_color(name)

	# Calculate font size
	font_size = get_font_size(dimensions, len(initials))

	# Generate the image
	img = generate_avatar_image(
		initials, dimensions, bg_color,
		settings_config["text_color"], font_size,
		settings_config["shape"]
	)

	# Handle output
	if settings_config["save_path"]:
		# Save to custom path
		img_path = settings_config["save_path"]
		os.makedirs(os.path.dirname(img_path), exist_ok=True)
		img.save(img_path, format=settings_config["output_format"].upper())
		return render_image_avatar(img_path, alt=f"Avatar for {name}", **attr)
	else:
		# Generate responsive avatar with all sizes
		try:
			import os
			os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'django.conf.global_settings')
			from django.conf import settings

			# Generate all sizes automatically
			all_sizes = ["small", "medium", "large", "xlarge"]
			initials_str = generate_initials(name, settings_config["max_initials"])
			generated_images = {}

			for size in all_sizes:
				# Get dimensions for this size
				size_dimensions = get_size_dimensions(size)
				size_font_size = get_font_size(size_dimensions, len(initials))

				# Generate image for this size
				size_img = generate_avatar_image(
					initials, size_dimensions, bg_color,
					settings_config["text_color"], size_font_size,
					settings_config["shape"]
				)

				# Create filename and path
				filename = f"{size}.{settings_config['output_format']}"
				size_dir = os.path.join(settings.MEDIA_ROOT, "avatars", "initials", initials_str)
				size_path = os.path.join(size_dir, filename)

				# Ensure directory exists
				os.makedirs(size_dir, exist_ok=True)

				# Save image
				size_img.save(size_path, format=settings_config["output_format"].upper())

				# Store media URL
				media_url = f"{settings.MEDIA_URL}avatars/initials/{initials_str}/{filename}"
				generated_images[size] = media_url

			# Return responsive figure element
			return render_responsive_avatar(generated_images, name, **attr)

		except Exception:
			# Fallback to base64 when Django settings are not available (e.g., in tests)
			buffer = io.BytesIO()
			img.save(buffer, format=settings_config["output_format"].upper())
			img_data = base64.b64encode(buffer.getvalue()).decode()
			data_url = f"data:image/{settings_config['output_format']};base64,{img_data}"
			return render_image_avatar(data_url, alt=f"Avatar for {name}", **attr)


def render_icon_avatar(icon_name, **icon_attrs):
	icon_classes = [
		f"mif-{icon_name}"
	]
	if icon_attrs.get("size"):
		try:
			size = int(icon_attrs.get("size"))
			if size >= 1 and size <= 10:
				icon_classes.append(f"mif-{size}x")
		except:
			pass

	if icon_attrs.get("text_color"):
		icon_classes.append(f"fg-{icon_attrs.get('text_color')}")

	if icon_attrs.get("bg_color"):
		icon_classes.append(f"bg-{icon_attrs.get('bg_color')}")

	return render_tag("span", {"class": " ".join(icon_classes)})


def render_image_avatar(image_url, **attrs):
	img_attrs = {"src": image_url, **attrs}
	return render_tag("img", attrs=img_attrs, close=False)


def render_responsive_avatar(generated_images, name, **attrs):
	"""Render a responsive avatar figure with picture elements for different sizes"""
	# Extract common attributes
	common_attrs = {k: v for k, v in attrs.items() if k not in ['class', 'style']}

	# Create figure element
	figure_attrs = {"class": "avatar-figure"}
	if 'class' in attrs:
		figure_attrs["class"] += f" {attrs['class']}"
	if 'style' in attrs:
		figure_attrs["style"] = attrs['style']

	# Create picture element with source sets for different sizes
	picture_content = ""

	# Add source elements for different sizes
	sizes_mapping = {
		"small": "(max-width: 480px) 48px",
		"medium": "(max-width: 768px) 64px",
		"large": "(max-width: 1024px) 96px",
		"xlarge": "(min-width: 1025px) 128px"
	}

	for size, media_query in sizes_mapping.items():
		if size in generated_images:
			source_attrs = {
				"media": media_query,
				"srcset": generated_images[size]
			}
			picture_content += render_tag("source", attrs=source_attrs, close=False)

	# Add img element as fallback (using medium size)
	fallback_img = generated_images.get(attrs.get("size"), generated_images.get("large", list(generated_images.values())[0]))
	img_attrs = {
		"src": fallback_img,
		"alt": f"Avatar for {name}",
		"class": "avatar-img",
		**common_attrs
	}
	picture_content += render_tag("img", attrs=img_attrs, close=False)

	# Create figure with picture inside
	figure_content = render_tag("picture", content=picture_content)
	return render_tag("figure", attrs=figure_attrs, content=figure_content)


def render_rating(value, max_value=5, **attrs):
	"""
	Renders MetroUI rating component.

	Args:
		value: Current rating
		max_value: Maximum rating
		**attrs: Additional HTML attributes
	"""
	default_attrs = {
		"class": "rating",
		"data-role": "rating",
		"data-value": str(value),
		"data-max": str(max_value)
	}

	final_attrs = {**default_attrs, **attrs}

	stars = ""
	for i in range(1, max_value + 1):
		star_class = "star" if i <= value else "star-empty"
		stars += render_tag("span", {"class": star_class}, "★")

	return render_tag("div", attrs=final_attrs, content=stars)
